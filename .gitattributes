# Normalize line endings by default
* text=auto

# Shell scripts MUST use LF — CRLF breaks bash with "^M: command not found"
*.sh text eol=lf

# Git hooks are extensionless shell scripts, so the *.sh rule above misses them.
# Without this they check out CRLF on Windows and fail on Unix with
# "bad interpreter: /bin/sh^M".
.githooks/* text eol=lf

# Node scripts use LF — they are read by node on every platform
*.mjs text eol=lf

# PowerShell scripts use CRLF — native Windows convention
*.ps1 text eol=crlf

# Vendored third-party licence files are extensionless, so the rules below miss
# them and `text=auto` would check them out CRLF on Windows — diverging a copy we
# state is byte-identical to its upstream. Pin them to LF.
LICENSE text eol=lf

# Markdown, YAML, and config files: use LF for consistency across OSes
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Binary files — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary